      "css": ".ds-row{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:76px;padding:14px 0;color:#f1f5f7;text-decoration:none;border-bottom:2px solid rgba(201,211,218,.22);font:800 clamp(22px,6vw,32px)/1.1 system-ui,sans-serif;letter-spacing:-.01em;outline:none}.ds-arrow{flex:none;display:grid;place-items:center;width:48px;height:48px;border-radius:50%;border:2px solid rgba(201,211,218,.5);transition:background-color .2s,border-color .2s}.ds-row:hover .ds-arrow,.ds-row:focus-visible .ds-arrow{background:#c8321f;border-color:#c8321f}.ds-row:focus-visible .ds-arrow{outline:3px solid #ecdcae;outline-offset:3px}"
