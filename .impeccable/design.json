    {
      "name": "Parts Tag",
      "kind": "card",
      "refersTo": "parts-tag",
      "description": "Manila shipping tag hung by a string from a steel peg; sways on the live page.",
      "html": "<div style=\"background:#1d4660;padding:24px\"><div class=\"ds-tag\"><span class=\"ds-string\"></span><span class=\"ds-peg\"></span><div class=\"ds-tag-card\"><h3><span class=\"n\">1</span>Tell us</h3><p>Text a photo or call, and tell us what the door is doing.</p></div></div></div>",
      "css": ".ds-tag{position:relative;padding-top:22px;max-width:320px;font-family:system-ui,sans-serif}.ds-peg{position:absolute;top:0;left:50%;width:12px;height:12px;margin-left:-6px;border-radius:50%;background:radial-gradient(circle at 40% 35%,#eef2f4,#7d8a94 70%);box-shadow:0 2px 3px rgba(0,0,0,.45);z-index:2}.ds-string{position:absolute;top:6px;left:50%;width:2px;height:36px;margin-left:-1px;background:#d9cfb6;z-index:1}.ds-tag-card{position:relative;background:#ecdcae;color:#2a2416;padding:30px 22px 22px;border-radius:6px 6px 10px 10px;clip-path:polygon(18% 0,82% 0,100% 14px,100% 100%,0 100%,0 14px);filter:drop-shadow(5px 9px 7px rgba(4,16,26,.45))}.ds-tag-card::before{content:'';position:absolute;top:12px;left:50%;width:14px;height:14px;margin-left:-7px;border-radius:50%;background:#1d4660;box-shadow:inset 0 0 0 3px #d4c18d}.ds-tag-card h3{margin:14px 0 6px;font-weight:900;font-size:26px;line-height:1.05;text-transform:uppercase;letter-spacing:-.01em}.ds-tag-card .n{color:#1d4660;margin-right:.35em}.ds-tag-card p{margin:0;font-size:17px;line-height:1.45;color:#3e3520}"
    },
