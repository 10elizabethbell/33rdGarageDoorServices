      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 22px;border-radius:10px;border:2px solid var(--steel,#c9d3da);font:800 18px/1.1 var(--font,system-ui,sans-serif);text-decoration:none;cursor:pointer;transition:background-color .2s,border-color .2s,color .2s,transform .1s}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid #ecdcae;outline-offset:3px}.ds-btn-red{background:#c8321f;border-color:#c8321f;color:#fff;box-shadow:0 6px 16px -6px rgba(5,15,25,.6)}.ds-btn-red:hover{background:#a8281a;border-color:#a8281a}"
